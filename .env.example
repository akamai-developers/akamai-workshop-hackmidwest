# Copy this file to .env and fill in your team key. Never commit .env.
# Only the brain is required. Each other block turns on one Akamai service.
# While a block is empty, the agent uses a local fallback and says so when it starts.

# Brain: the hackathon inference endpoint. Paste the team key from the organizers (starts with hk_).
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=hk_paste_your_team_key_here

# Model names. These are the hackathon aliases. Change them only if you switch providers.
CHAT_MODEL=hackathon-chat
EMBEDDING_MODEL=hackathon-embedding

# Knowledge: an Object Storage bucket in Seattle. Guide 01 (or scripts/up.sh) fills these in.
# Empty: the agent reads the files in docs/sample/ instead.
OBJ_ENDPOINT=
OBJ_BUCKET=
OBJ_ACCESS_KEY=
OBJ_SECRET_KEY=

# Memory: Managed PostgreSQL with pgvector. Guide 02 (or scripts/status.sh) fills this in.
# Empty: conversations and document vectors live in the agent process and vanish on restart.
DATABASE_URL=

# Reflexes: Valkey for the embedding cache and the rate limit. compose.yaml sets this on the Linode.
# Empty: no cache and no rate limit.
VALKEY_URL=
