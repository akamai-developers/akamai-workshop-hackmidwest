# Copy this file to .env and fill in your team key. Never commit .env.
# Only inference settings are required. Other blocks connect optional services.
# While a block is empty, the agent uses a local fallback and says so when it starts.

# Inference: the workshop endpoint. Paste the team key from the organizers (starts with hk_).
# https://api.openai.com/v1
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=paste_your_team_key_here

# Model names. These are the hackathon aliases. Change them only if you switch providers.
# gpt-5.4-mini
CHAT_MODEL=hackathon-chat
# text-embedding-3-small
EMBEDDING_MODEL=hackathon-embedding

# Object Storage: the storage lab or scripts/up.sh fills these in.
# Empty: the agent reads the files in docs/sample/ instead.
OBJ_ENDPOINT=
OBJ_BUCKET=
OBJ_ACCESS_KEY=
OBJ_SECRET_KEY=
# The access key's id. The agent does not use it; scripts/down.sh uses it to revoke the key.
OBJ_KEY_ID=

# PostgreSQL: the database lab or scripts/status.sh fills this in.
# Empty: conversations and document vectors live in the agent process and vanish on restart.
DATABASE_URL=

# Valkey: embedding cache and session rate limit. compose.yaml sets this on the Linode.
# Empty: no cache and no rate limit.
VALKEY_URL=

